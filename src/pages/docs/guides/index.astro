<DocsLayout
  section="guides"
  href="/docs/guides/"
  title="How-to guides"
  heading="Do the thing."
  lede="Each guide is one task: a short explanation, then commands you can paste into a terminal. macOS and Linux are assumed; Windows differences are noted where they exist. The architecture documentation explains the machinery underneath when you want it."
  description="Task-shaped tebako guides: install, run, package, publish, shim, jail, verify, debug, and inspect — every command copy-pasteable."
>
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {guides.map((g) => (
        <a href={g.href} class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
          <p class="tb-eyebrow">{g.eyebrow}</p>
          <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">{g.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">{g.desc}</p>
        </a>
      ))}
    </div>

    <div class="mt-6">
      <a href="/docs/architecture/migration/" class="group block rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
