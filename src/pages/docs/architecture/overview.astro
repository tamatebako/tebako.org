            <text x="130" y="44" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">the source factory — canonical patches,</text>
            <text x="130" y="58" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">versions.yml, the release monitor</text>
            <text x="130" y="78" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" font-weight="600" fill="var(--tb-c-accent)">patched-src tarballs · SHIPPED</text>
          </g>
          <g transform="translate(340, 24)">
            <rect width="260" height="92" rx="10" fill="var(--tb-c-card)" stroke="var(--tb-c-divider-strong)" stroke-width="1.5" />
            <text x="130" y="26" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13.5" font-weight="600" fill="var(--tb-c-text-1)">tebako-runtime-ruby</text>
            <text x="130" y="44" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">the runtime factory — interpreter exe</text>
            <text x="130" y="58" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">+ env .tfs image per ruby × triplet</text>
            <text x="130" y="78" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" font-weight="600" fill="var(--tb-c-accent)">exe + image + index · SHIPPED</text>
          </g>
          <g transform="translate(650, 24)">
            <rect width="260" height="92" rx="10" fill="var(--tb-c-card)" stroke="var(--tb-c-divider-strong)" stroke-width="1.5" />
            <text x="130" y="26" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13.5" font-weight="600" fill="var(--tb-c-text-1)">tebako-bootstrap</text>
            <text x="130" y="44" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">the loader — reads its trailer, resolves</text>
            <text x="130" y="58" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">the runtime, verifies, hands off</text>
            <text x="130" y="78" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" font-weight="600" fill="var(--tb-c-accent)">Rust · static · &lt; 3 MB · SHIPPED</text>
          </g>

          <!-- connectors: top satellites → core -->
          <line x1="160" y1="116" x2="380" y2="196" stroke="var(--tb-c-text-3)" stroke-width="1.5" marker-end="url(#pm-arrow)" />
          <line x1="470" y1="116" x2="470" y2="196" stroke="var(--tb-c-text-3)" stroke-width="1.5" marker-end="url(#pm-arrow)" />
          <line x1="780" y1="116" x2="560" y2="196" stroke="var(--tb-c-text-3)" stroke-width="1.5" marker-end="url(#pm-arrow)" />

