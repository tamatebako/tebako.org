---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ArchDocsNav from '../../../components/docs/ArchDocsNav.astro'
import StatusPill from '../../../components/docs/StatusPill.astro'

const LINKS = {
  tebako: 'https://github.com/tamatebako/tebako',
  tfsCrate: 'https://github.com/tamatebako/tebako/tree/main/crates/tfs',
  tfsCli: 'https://github.com/tamatebako/tebako/tree/main/crates/tfs-cli',
  cliCrate: 'https://github.com/tamatebako/tebako/tree/main/crates/tebako-cli',
  bootstrapCrate: 'https://github.com/tamatebako/tebako/tree/main/crates/tebako-bootstrap',
  rubyRepo: 'https://github.com/tamatebako/ruby',
  runtimeRepo: 'https://github.com/tamatebako/tebako-runtime-ruby',
  dwarfsT: 'https://github.com/tamatebako/dwarfs-t',
  dwarfsTRs: 'https://github.com/tamatebako/dwarfs-t-rs',
  libtfsRepo: 'https://github.com/tamatebako/libtfs',
  tebakoV1: 'https://github.com/tamatebako/tebako-v1',
  mnenv: 'https://github.com/metanorma/mnenv',
}
---
<!-- normative: spec 01, spec 02, spec 05, spec 09 — rewritten 2026-08-25; dispatch chain from spec 07, exit codes from spec 06 §4, limnifs default from spec 20, router facts from spec 11; 33 tebako_fs_* exports counted at crates/tfs/src/c_api.rs; unverified-first rollout at spec 06 §3 + spec 09 preamble -->

<BaseLayout title="What is tebako? — Tebako Architecture" description="Tebako is a packaging and loading ecosystem: stitch any payload into a single executable, or ship managed, versioned, signed payloads with shared runtimes. Ruby is the first runtime instance; TFS, a userland virtual filesystem, sits underneath.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-32">
    <p class="tb-eyebrow">ARCHITECTURE · 00</p>
    <h1 class="mt-3">What is tebako?</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      Tebako is a <strong class="text-[var(--tb-c-text-1)]">packaging and loading ecosystem</strong> —
      not a Ruby tool. It stitches a payload into a single transparent executable your users never
      think about, or ships it as a managed, versioned, signed payload with shared runtimes. Ruby is
      the first runtime instance; the loader neither knows nor cares what language it starts.
      Underneath sits TFS, a userland virtual filesystem that lets ordinary binaries mount disk
      images in-process.
    </p>

    <ArchDocsNav />

    <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-[var(--tb-c-divider)] px-5 py-4" style="background: var(--tb-c-bg-soft);">
      <StatusPill status="shipped" />
      <span class="text-sm text-[var(--tb-c-text-2)]">standalone press — lean + fat executables, released and downloadable today</span>
      <StatusPill status="shipped" />
      <span class="text-sm text-[var(--tb-c-text-2)]">managed mode — shims, per-invocation dispatch, the shared cache</span>
      <StatusPill status="planned" note="partial" />
      <span class="text-sm text-[var(--tb-c-text-2)]">OpenPGP verification in the loader — the unverified-first rollout (<a href="/docs/architecture/chain-of-trust/" class="tb-link-underline text-[var(--tb-c-accent)]">details</a>)</span>
    </div>

    <!-- ============ FOUR AXES ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Generic by construction.</h2>
      <p class="mb-8 max-w-2xl text-[var(--tb-c-text-2)]">
        One design, generic across four axes. Nothing in the loader, the container, or the store
        is Ruby-shaped — Ruby simply happens to be the first runtime the factories produce.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">Any runtime</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            A runtime is a payload that <em>provides</em> an interpreter — ruby today; python, julia,
            anything later. The loader hands off to an entrypoint; it never learns a language.
          </p>
        </div>
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">Any platform</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            Artifacts are built per platform triplet — seven are locked, from
            {' '}<code class="font-[var(--font-mono)] text-sm">aarch64-macos</code> to
            {' '}<code class="font-[var(--font-mono)] text-sm">x86_64-windows-ucrt</code>.
            Pure-language payloads may also be <code class="font-[var(--font-mono)] text-sm">universal</code>.
          </p>
        </div>
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">Any payload</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            Application code, data, fonts, native tools, runtimes themselves — all
            {' '}<code class="font-[var(--font-mono)] text-sm">.tfs</code> images of the same kind,
            differing only in what their manifests declare.
          </p>
        </div>
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">Any composition</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            Payloads stitch onto a single binary, and payloads recursively mount other payloads at
            paths. Composition is a manifest declaration, not a rebuild.
          </p>
        </div>
      </div>
    </div>

    <!-- ============ SIX CAPABILITIES ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Six capabilities.</h2>
      <p class="mb-8 max-w-2xl text-[var(--tb-c-text-2)]">
        Everything tebako does decomposes into six verbs.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[640px] text-left text-sm">
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            <tr>
              <td class="px-6 py-4 font-[var(--font-mono)] font-semibold text-[var(--tb-c-accent)]">Stitch</td>
              <td class="px-6 py-4 leading-relaxed text-[var(--tb-c-text-2)]">N payload images + the bootstrap into one executable (fat), or a small executable that resolves the parts on demand (lean).</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-[var(--font-mono)] font-semibold text-[var(--tb-c-accent)]">Load</td>
              <td class="px-6 py-4 leading-relaxed text-[var(--tb-c-text-2)]">Mount payloads — recursively — into one VFS, then transfer control to the declared entrypoint.</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-[var(--font-mono)] font-semibold text-[var(--tb-c-accent)]">Share</td>
              <td class="px-6 py-4 leading-relaxed text-[var(--tb-c-text-2)]">Runtimes and payloads download once into a machine-wide content cache; every package on the machine reuses them.</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-[var(--font-mono)] font-semibold text-[var(--tb-c-accent)]">Shim</td>
              <td class="px-6 py-4 leading-relaxed text-[var(--tb-c-text-2)]">Every executable an installed payload provides becomes a registered command on PATH, dispatched per invocation.</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-[var(--font-mono)] font-semibold text-[var(--tb-c-accent)]">Jail</td>
              <td class="px-6 py-4 leading-relaxed text-[var(--tb-c-text-2)]">A declarative host-filesystem policy per run, enforced by the VFS layer — not by the payload's good behavior.</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-[var(--font-mono)] font-semibold text-[var(--tb-c-accent)]">Trust</td>
              <td class="px-6 py-4 leading-relaxed text-[var(--tb-c-text-2)]">Opt-in per package: signatures and encryption. Unsigned stays first-class — verified strictly when signed, never silently downgraded.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ============ DIAGRAM 1: PLATFORM MAP ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The platform, on one map.</h2>
      <p class="mb-8 max-w-2xl text-[var(--tb-c-text-2)]">
        Everything orbits one seam: the{' '}
        <a href="/docs/architecture/vfs/" class="tb-link-underline font-medium text-[var(--tb-c-accent)]">tebako_fs_* C ABI</a>,
        implemented by the Rust tfs crate. The factories feed it runtimes; feedstock repos — one per
        package — build payloads on those runtimes and host them on their own releases ({' '}
        <a href="/docs/architecture/factories/" class="tb-link-underline text-[var(--tb-c-accent)]">the factories</a>
        {' '}walk the chain). The trust layer sits beneath everything that moves bytes.
      </p>

      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)] p-6" style="background: var(--tb-c-bg-soft);">
        <svg viewBox="0 0 940 540" class="w-full min-w-[760px]" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Platform map: the TFS core, the factories and the product line around it, the trust layer beneath">
          <defs>
            <marker id="pm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 Z" fill="var(--tb-c-text-3)" />
            </marker>
          </defs>

          <!-- top satellites -->
