          <line x1="660" y1="274" x2="624" y2="274" stroke="var(--tb-c-text-3)" stroke-width="2" marker-end="url(#pipe-arrow-side)" />

          <g transform="translate(660, 356)">
            <rect width="270" height="88" rx="10" fill="var(--tb-c-card)" stroke="var(--tb-c-divider-strong)" stroke-width="1.5" />
