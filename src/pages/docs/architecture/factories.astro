---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ArchDocsNav from '../../../components/docs/ArchDocsNav.astro'
import StatusPill from '../../../components/docs/StatusPill.astro'

const LINKS = {
  rubyLang: 'https://www.ruby-lang.org/en/downloads/releases/',
  rubyRepo: 'https://github.com/tamatebako/ruby',
  rubyRel: 'https://github.com/tamatebako/ruby/releases/tag/v0.2.27',
  rubyMonitor: 'https://github.com/tamatebako/ruby/blob/main/.github/workflows/release-monitor.yml',
  runtimeRepo: 'https://github.com/tamatebako/tebako-runtime-ruby',
  runtimeRel: 'https://github.com/tamatebako/tebako-runtime-ruby/releases/tag/v0.16.9',
  runtimeManifest: 'https://github.com/tamatebako/tebako-runtime-ruby/releases/download/v0.16.9/manifest.json',
  productRepo: 'https://github.com/tamatebako/tebako',
  productRel: 'https://github.com/tamatebako/tebako/releases/tag/v0.2.5',
  dwarfsRepo: 'https://github.com/tamatebako/dwarfs-t',
  dwarfsRsRepo: 'https://github.com/tamatebako/dwarfs-t-rs',
  containersRepo: 'https://github.com/tamatebako/tebako-ci-containers',
  packagesOrg: 'https://github.com/tebako-packages',
  packagesIndex: 'https://github.com/tebako-packages/index',
  inkscapeRepo: 'https://github.com/tebako-packages/inkscape',
}

const stages = [
  {
    stage: 'Upstream',
    repo: 'ruby-lang.org',
    href: LINKS.rubyLang,
    ships: 'Official Ruby source tarballs — the ultimate input of the whole chain.',
    status: 'external',
  },
  {
    stage: 'Release monitor',
    repo: 'tamatebako/ruby · release-monitor.yml',
    href: LINKS.rubyMonitor,
    ships: 'Daily cron: diff upstream releases against versions.yml, onboard new rubies (entry + patch selection + lint → PR → tag → source release → pin-bump dispatch). A failing patch files a named issue carrying the hunk output — loud, never silent.',
    status: 'shipped',
  },
  {
    stage: 'Source factory',
    repo: 'tamatebako/ruby',
    href: LINKS.rubyRel,
    ships: 'v0.2.27: 149 assets — 37 rubies (3.1.6–4.0.6) × 4 scenario tarballs (linux-gnu unsuffixed, linux-musl, msys-pass1, msys-pass2) + SHA256SUMS. The only place ruby patches are ever applied; every upstream fetch is sha256-pinned in versions.yml.',
    status: 'shipped',
  },
  {
    stage: 'Runtime factory',
    repo: 'tebako-runtime-ruby',
    href: LINKS.runtimeRel,
    ships: 'v0.16.9: 334 assets — 22 catalog rubies (3.1.6–4.0.6) × 7 triplets, each an interpreter exe + env .tfs (windows adds the ruby DLL), plus manifest.json (154 entries) + SHA256SUMS.txt. Builds the pinned source in toolchain containers, links the pinned product link unit, boot-smokes every runtime before publish.',
    status: 'shipped',
  },
  {
    stage: 'Format library',
    repo: 'dwarfs-t',
    href: LINKS.dwarfsRepo,
    ships: 'The only C++ in the stack: the DwarFS-T image format (FlatBuffers metadata — upstream dwarfs cannot read it) behind the dwarfs_c_* ABI. Read-only at runtime forever; the Writer runs at creation time only. Releases publish the pinned per-triplet vcpkg baselines the downstream builds compile against.',
    status: 'shipped',
  },
  {
    stage: 'FFI bindings',
    repo: 'dwarfs-t-rs',
    href: LINKS.dwarfsRsRepo,
    ships: 'Standalone Rust bindings for the format library (the dwarfs-t crate) — deliberately not tebako-specific. This is how the product’s tfs crate reads and writes images in-process: no mkdwarfs shell-out, ever.',
    status: 'shipped',
  },
  {
    stage: 'Product',
    repo: 'tamatebako/tebako',
    href: LINKS.productRel,
    ships: 'v0.2.5: five binaries (tebako, tfs, tebako-pkg, tebako-shim, tebako-bootstrap) × 7 triplets + the per-triplet link units + manifest.json + SHA256SUMS. The bootstrap is size-gated under 3 MB on every triplet, and a partial asset set fails the release outright.',
    status: 'shipped',
  },
  {
    stage: 'Build infrastructure',
    repo: 'tebako-ci-containers',
    href: LINKS.containersRepo,
    ships: 'The toolchain container images the factory matrices build in — the tpkg-builder line, taking over from the pinned v1 container tags.',
    status: 'shipped',
  },
  {
    stage: 'Toolkit factory',
    repo: 'tebako-packages/*',
    href: LINKS.packagesOrg,
    ships: 'The conda-forge model: one feedstock repo per package — recipe + patches + manifest templates + CI. A release carries the per-triplet payload .tfs artifacts + SHA256SUMS + the repo’s own tpkg-registry.yaml; tags are the upstream version plus a packaging revision on re-release (metanorma 1.16.9 → 1.16.9-3).',
    status: 'shipped',
  },
  {
    stage: 'Catalog',
    repo: 'tebako-packages/index',
    href: LINKS.packagesIndex,
    ships: 'The registry-of-registries: one tpkg-registry.yaml listing each feedstock’s registry ref and summary. tebako add-registry tfs:github:tebako-packages/index exposes the whole catalog; nothing is hosted centrally.',
    status: 'shipped',
  },
]
---

<!-- normative: spec 13, spec 19 -->
<BaseLayout title="The factories — Tebako architecture" description="From an upstream language release to a published runtime, and from a recipe to a published payload: the source factory, the runtime factory, the product repo, and the tebako-packages feedstocks. Releases are the interface.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-32">
    <p class="tb-eyebrow">ARCHITECTURE · 05</p>
    <h1 class="mt-3">The factories.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      How an upstream language release becomes a runtime, how a runtime becomes a
      package, and how a recipe becomes a payload — across a fleet of repositories
      that talk to each other only through published, sha256-anchored releases.
    </p>

    <ArchDocsNav />

    <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-[var(--tb-c-divider)] px-5 py-4" style="background: var(--tb-c-bg-soft);">
      <StatusPill status="shipped" />
      <span class="text-sm text-[var(--tb-c-text-2)]">every stage on this page publishes today — the versions and pins named are the ones in force</span>
    </div>

    <!-- ============ DIAGRAM: THE CHAIN ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The chain.</h2>
      <p class="mb-8 max-w-3xl text-[var(--tb-c-text-2)]">
        Four factories and one product repo, each building its own platforms and
        publishing its own versioned releases. This is the ruby instance of the
        model; the model itself is language-agnostic — a python factory would take
        the same shape.
      </p>
