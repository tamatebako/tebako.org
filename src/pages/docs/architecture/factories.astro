          <g transform="translate(320, 356)">
            <rect width="300" height="72" rx="10" fill="var(--tb-c-card)" stroke="var(--tb-c-accent)" stroke-width="1.5" />
            <text x="150" y="24" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="14" font-weight="600" fill="var(--tb-c-text-1)">the runtime release</text>
            <text x="150" y="42" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">exe + env .tfs + manifest.json + SHA256SUMS</text>
            <text x="150" y="58" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">keep-forever · never deleted, never replaced</text>
          </g>
          <line x1="620" y1="392" x2="656" y2="392" stroke="var(--tb-c-text-3)" stroke-width="2" marker-end="url(#pipe-arrow-side)" />

          <text x="470" y="452" text-anchor="middle" font-family="var(--font-sans), sans-serif" font-size="10.5" fill="var(--tb-c-text-3)">
