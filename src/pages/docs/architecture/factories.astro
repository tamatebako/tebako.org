            <text x="135" y="56" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">read-only at runtime · creation-time Writer</text>
            <text x="135" y="74" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" font-weight="600" fill="var(--tb-c-accent)">per-triplet vcpkg baselines · SHIPPED</text>
          </g>
          <line x1="145" y1="196" x2="145" y2="224" stroke="var(--tb-c-text-3)" stroke-width="2" marker-end="url(#pipe-arrow-side)" />

          <g transform="translate(10, 230)">
            <rect width="270" height="88" rx="10" fill="var(--tb-c-card)" stroke="var(--tb-c-divider-strong)" stroke-width="1.5" />
            <text x="135" y="24" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="14" font-weight="600" fill="var(--tb-c-text-1)">dwarfs-t-rs — Rust FFI</text>
            <text x="135" y="42" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">standalone bindings · not tebako-specific</text>
            <text x="135" y="56" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">the dwarfs-t crate behind crates/tfs</text>
            <text x="135" y="74" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" font-weight="600" fill="var(--tb-c-accent)">in-process imaging · SHIPPED</text>
          </g>
          <line x1="145" y1="322" x2="145" y2="350" stroke="var(--tb-c-text-3)" stroke-width="2" marker-end="url(#pipe-arrow-side)" />

          <g transform="translate(10, 356)">
            <rect width="270" height="88" rx="10" fill="var(--tb-c-card)" stroke="var(--tb-c-divider-strong)" stroke-width="1.5" />
            <text x="135" y="24" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="14" font-weight="600" fill="var(--tb-c-text-1)">tamatebako/tebako</text>
            <text x="135" y="42" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">the product · tpkg · tfs · cli · pkg · shim</text>
            <text x="135" y="56" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" fill="var(--tb-c-text-3)">bootstrap · driver · resolve · http · signer</text>
            <text x="135" y="74" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9.5" font-weight="600" fill="var(--tb-c-accent)">v0.2.5 · 5 binaries × 7 triplets · size-gated</text>
          </g>

          <!-- the product's link unit feeds the runtime factory -->
          <line x1="250" y1="356" x2="250" y2="340" stroke="var(--tb-c-text-3)" stroke-width="2" />
          <line x1="250" y1="340" x2="400" y2="340" stroke="var(--tb-c-text-3)" stroke-width="2" />
          <line x1="400" y1="340" x2="400" y2="322" stroke="var(--tb-c-text-3)" stroke-width="2" marker-end="url(#pipe-arrow-side)" />
          <text x="325" y="332" text-anchor="middle" font-family="var(--font-mono), monospace" font-size="9" fill="var(--tb-c-text-3)">pinned link unit</text>

          <!-- the product CLI feeds the feedstocks -->
          <line x1="145" y1="444" x2="145" y2="486" stroke="var(--tb-c-text-3)" stroke-width="2" />
          <line x1="145" y1="486" x2="795" y2="486" stroke="var(--tb-c-text-3)" stroke-width="2" />
