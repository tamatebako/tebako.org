---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { makeDocsPaths, extractToc } from '../../../lib/docs-route'

export const getStaticPaths = () => makeDocsPaths('architecture')

interface EntryProps {
  entry: { data: { title: string; heading?: string; lede?: string; description: string }; rendered?: { html?: string } }
  href: string
}
const { entry, href }: EntryProps = Astro.props
const html = entry.rendered?.html ?? ''
const toc = extractToc(html)
---

<DocsLayout
  section="architecture"
  href={href}
  title={entry.data.title}
  heading={entry.data.heading}
  lede={entry.data.lede}
  description={entry.data.description}
  toc={toc}
>
  <div class="tb-prose mt-16" set:html={html} />
</DocsLayout>
