---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import DocsNav from '../../../components/docs/DocsNav.astro'
import { getSection } from '../../../config/docs'

const sec = getSection('architecture')
const DESCRIPTIONS: Record<string, string> = {
  'Overview': 'What tebako is and what it does — the one-page picture.',
  'Concepts': 'The wire format, the trailer, slot records, flags, and format IDs.',
  'Anatomy': 'What is inside a running tebako process, exit codes included.',
  'Building blocks': 'The nine parts of the system, one page each.',
  'Factories': 'How an upstream language release becomes a runtime, and a recipe becomes a package.',
  'Runtime as image': 'The two-artifact model: interpreter executable plus mounted environment image.',
  'Dispatch': 'How a command name becomes the right payload, version, and runtime.',
  'The store': 'The ~/.tebako directory: runtimes, payloads, shims, registries, trust.',
  'VFS model': 'The userland virtual filesystem: mount table, longest-prefix dispatch, pluggable backends.',
  'Exec tiers': 'Four ways to run a binary inside an image, from interpreted to spawned.',
  'Chain of trust': 'SHA-256 anchors, verification at install, signing, and the root ceremony.',
  'Repositories': 'The repo map: who owns what, and the product crate map.',
  'Comparisons': 'How tebako compares to version managers, containers, and language packagers.',
  'Migration (v1→v2)': 'What changed between the v1 and v2 architectures.',
  'v1→v2 flag map': 'The flag-by-flag migration guide for the tebako CLI.',
  'Contributors': 'The engineering order, contract suites, and the SSOT ownership table.',
  'Driver contract': 'The wire format the bootstrap uses to hand off to the runtime.',
  'Composition': 'The dependency grammar: requires, needs, mounts, resolution.',
  'Overlays': 'Declared writes and sealed reads on read-only images.',
  'Image formats': 'The format axis: limnifs, dwarfs, squashfs, zip — and auto-detection.',
  'Jails & proxying': 'Declarative host-filesystem policy, record mode, and the platform floor.',
  'Encryption': 'Per-image opt-in encryption, key model, and the PQC suites.',
  'Interposition': 'The L/E/R taxonomy and per-platform delivery of filesystem interposition.',
  'Observability': 'The trace toolkit: what a payload touches, which hop failed, what escaped.',
  'Contract model': 'The edges, the evolution law, and the non-goals.',
}
---

<BaseLayout
  title="Architecture — Tebako"
  description="The tebako architecture: the three-part package model, the wire format, the runtime, the VFS, the store, trust, and every subsystem."
>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-32">
    <p class="tb-eyebrow">ARCHITECTURE</p>
    <h1 class="mt-3">The system, page by page.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      Every concept in tebako has exactly one page here — from the wire format
      to the trust model, from the VFS to the trace toolkit.
    </p>

    <DocsNav section="architecture" />

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sec.entries.filter((entry) => entry.href !== sec.homeHref).map((entry, i) => (
        <a
          href={entry.href}
          class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]"
          style="background: var(--tb-c-bg-soft);"
        >
          <p class="font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">
            {entry.label}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            {DESCRIPTIONS[entry.label] || 'The details.'}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
