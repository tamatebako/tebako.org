---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ArchDocsNav from '../../../components/docs/ArchDocsNav.astro'
import StatusPill from '../../../components/docs/StatusPill.astro'

const LINKS = {
  spec20: 'https://github.com/tamatebako/tebako/blob/main/docs/spec/20-limnifs-backend.md',
  spec02: 'https://github.com/tamatebako/tebako/blob/main/docs/spec/02-tpkg-wire-format.md',
  spec11: 'https://github.com/tamatebako/tebako/blob/main/docs/spec/11-tfs-vfs-model.md',
}

const formatRows = [
  { id: '0', name: 'auto', reader: 'magic detection decides', toolchain: '—', status: 'the hint value that defers to bytes' },
  { id: '1', name: 'dwarfs', reader: 'dwarfs-t (FlatBuffers metadata)', toolchain: 'C++ (vcpkg/cmake)', status: 'first-class read; explicit --format dwarfs write opt-in' },
  { id: '2', name: 'squashfs', reader: 'squashfs-tools-ng', toolchain: 'C (POSIX-only today)', status: 'read backend' },
  { id: '3', name: 'zip', reader: 'pure Rust', toolchain: 'none', status: 'read backend' },
  { id: '4', name: '—', reader: 'never mounted', toolchain: '—', status: 'legacy runtime-role wart — never reused, never given new meaning' },
  { id: '5', name: 'limnifs', reader: 'limnifs-core, #![forbid(unsafe_code)]', toolchain: 'pure Rust, zero system deps', status: 'THE DEFAULT write format; read everywhere' },
]

const featureRows = [
  { feature: 'backend-dwarfs-t', backend: 'dwarfs-t (FlatBuffers)', toolchain: 'C++ (vcpkg/cmake via dwarfs-t-rs)' },
  { feature: 'backend-squashfs', backend: 'squashfs', toolchain: 'C (squashfs-tools-ng; POSIX-only today)' },
  { feature: 'backend-zip', backend: 'zip', toolchain: 'pure Rust' },
  { feature: 'backend-tar', backend: 'tar (+ gz/zst envelopes)', toolchain: 'pure Rust' },
  { feature: 'backend-limnifs', backend: 'limnifs', toolchain: 'pure Rust, #![forbid(unsafe_code)], no system deps' },
]

const probeRows = [
  { order: '1', magic: 'PK\\x03\\x04 / PK\\x05\\x06', format: 'zip' },
  { order: '2', magic: 'DWARFS', format: 'dwarfs' },
  { order: '3', magic: 'hsqs', format: 'squashfs' },
  { order: '4', magic: 'LMFS', format: 'limnifs — disjoint 4-byte prefix against every arm above' },
  { order: '5', magic: '\\x1f\\x8b\\x08 · \\x28\\xb5\\x2f\\xfd', format: 'tar envelopes (gzip, zstd)' },
  { order: '6', magic: 'header-checksum heuristic', format: 'tar — always LAST (weak)' },
  { order: '7', magic: '—', format: 'Unknown → EINVAL at mount' },
]
---
<!-- normative: spec 20 (limnifs backend, default-format rationale §6b, writer floor constraints §5), spec 02 §3/§6 (format_id axis, orthogonality), spec 11 §3 (detection order, compiled-out rule) §5 (mount-source kinds) -->

<BaseLayout title="Image formats — Tebako architecture" description="One axis, one question: format_id answers only 'how do I read these bytes'. LimniFS is the default write format — pure Rust, content-addressed, no toolchain; dwarfs stays a first-class read backend; detection is by magic, never by hint.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-32">
    <p class="tb-eyebrow">ARCHITECTURE · 19</p>
    <h1 class="mt-3">Image formats.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      Every payload slice is a byte shape behind one seam. The format axis answers exactly one
      question — <em>how do I read these bytes</em> — and nothing else: what a payload IS, whether
      it is a runtime, where its entrypoint lives, are manifest semantics that never touch the
      format id.
    </p>

    <ArchDocsNav />

    <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-[var(--tb-c-divider)] px-5 py-4" style="background: var(--tb-c-bg-soft);">
      <StatusPill status="shipped" note="six in-tree formats; LimniFS the default write format since v0.2.0; magic detection authoritative" />
      <StatusPill status="planned" note="the pure-Rust runtime line (backend-limnifs only) is a recorded goal, its own release line" />
    </div>

    <!-- ============ THE AXIS ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The format_id axis.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        A 32-bit field in each trailer slot record — a HINT. Magic detection on the actual bytes is
        authoritative; a slot stamped 5 whose bytes do not open with <code class="font-[var(--font-mono)] text-sm">LMFS</code>{' '}
        mounts as what the magic says. Ids ≥ 6 are unallocated.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[820px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">ID</th>
              <th class="px-5 py-3 font-medium">FORMAT</th>
              <th class="px-5 py-3 font-medium">READER</th>
              <th class="px-5 py-3 font-medium">TOOLCHAIN</th>
              <th class="px-5 py-3 font-medium">STATUS</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            {formatRows.map((r) => (
              <tr>
                <td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">{r.id}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]"><code class="font-[var(--font-mono)]">{r.name}</code></td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">{r.reader}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">{r.toolchain}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-3)]">{r.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl text-sm text-[var(--tb-c-text-3)]">
        Id 4 is the v1 wart: a runtime ROLE smuggled into the format field so v1 loaders skip
        handing the fat runtime slot over as a mount. It is kept for backward compatibility and
        never reused — roles live in manifests, and new semantics are never again smuggled into the
        format axis. Documented deviation, locked: the reference C99 reader keeps its bound at 4 and
        rejects a format-5 slot with its NAMED invalid error — fail-closed and correct, since a
        v1-era reader cannot read limnifs bytes.
      </p>
    </div>

    <!-- ============ DETECTION ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Detection: strong magic first, weak heuristics last.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        One 512-byte sniff window, one locked probe order. Every mount — host file, memory,
        file-region (offset+length), or VFS-file-region (an image addressed by a path INSIDE an
        existing mount, read through the owning mount's pread) — serves one byte-slice core.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">#</th>
              <th class="px-5 py-3 font-medium">MAGIC</th>
              <th class="px-5 py-3 font-medium">FORMAT</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            {probeRows.map((r) => (
              <tr>
                <td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">{r.order}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]"><code class="font-[var(--font-mono)]">{r.magic}</code></td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-3)]">{r.format}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- ============ COMPILE SEPARATION ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Compile separation: ship exactly the formats you must read.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        Backends compile in per cargo feature. The <code class="font-[var(--font-mono)] text-sm">enc</code>{' '}
        transform feature is orthogonal — it stacks over any backend.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">FEATURE</th>
              <th class="px-5 py-3 font-medium">BACKEND</th>
              <th class="px-5 py-3 font-medium">TOOLCHAIN</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            {featureRows.map((r) => (
              <tr>
                <td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">{r.feature}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">{r.backend}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-3)]">{r.toolchain}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl text-sm text-[var(--tb-c-text-3)]">
        Per-product defaults: the packager and human tools (tebako-cli, tfs-cli, tebako-pkg) ship
        ALL backends; the driver inside every runtime exe and the preload shim ship all backends, so
        any package runs on any runtime; the bootstrap ships NO backend, ever — it never mounts, it
        stays format-agnostic and inside its size gate. The compiled-out rule is locked: a mount
        whose detected format has no compiled-in backend fails with the NAMED{' '}
        <code class="font-[var(--font-mono)] text-xs">ENOTSUP</code>, naming the format — never a
        silent re-route, never a partial read, never a crash.
      </p>
    </div>

    <!-- ============ LIMNIFS DEFAULT ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Why LimniFS is the default.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        The default is the format every payload takes when the operator says nothing, so it must be
        the one with the least toolchain exposure, the least build cost, and no loss of capability.
      </p>
      <pre class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)] p-6 font-[var(--font-mono)] text-xs leading-relaxed text-[var(--tb-c-text-2)] sm:text-sm" style="background: var(--tb-c-bg-soft);"><code>1. Pure Rust, #![forbid(unsafe_code)], zero system dependencies —
   reading AND writing the default format needs no C++ toolchain,
   no vcpkg, no cmake
2. Build wall-clock: limnifs-core compiles everywhere Rust compiles,
   semver-pinned from crates.io — the dwarfs-t vcpkg ports were the
   CI cost driver (per-target C++ cross-compilation)
3. Content-addressed: every drop is BLAKE3(plaintext) — image-internal
   integrity and dedup come from the format, not bolted-on machinery
4. Read efficiency: on-demand per-class decompression; inline drops
   serve small files straight from the metadata blob, no slab access
5. Unambiguous detection: the strong LMFS magic is disjoint from
   every existing probe arm
6. Nothing else changes: existing dwarfs packages, runtimes, and
   payload artifacts are untouched; dwarfs stays a first-class
   explicit --format dwarfs opt-in and a supported read backend
   forever</code></pre>
      <p class="mt-4 max-w-3xl text-sm text-[var(--tb-c-text-3)]">
        Both writer entry points — <code class="font-[var(--font-mono)] text-xs">tfs mkimage</code>{' '}
        and <code class="font-[var(--font-mono)] text-xs">tebako press</code> — default to limnifs
        and work fully in-process: no <code class="font-[var(--font-mono)] text-xs">limni</code> or{' '}
        <code class="font-[var(--font-mono)] text-xs">mkdwarfs</code> binary, no PATH lookup, no
        shell-out. While the published runtime fleet's readers span pre-fix limnifs lines, the
        writers pin a floor-safe recipe (no shared-inline dedup, lz4-HC metadata, lz4-or-store
        content drops); every constraint names its lift condition — a factory runtime cut whose link
        unit carries limnifs-core ≥ 0.2.53. A payload written outside the constraints is not
        rejected — it is simply below the floor's guarantee: it may mount on newer readers and fail
        closed, by name, on older ones.
      </p>
    </div>

    <!-- ============ TRANSFORMS LAW ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Read-only at runtime, forever.</h2>
      <p class="max-w-3xl text-[var(--tb-c-text-2)]">
        The transforms law binds every backend: no format backend learns to write; creation-time
        writers are the only write path; COW and ENC stack above as transforms. Writes to a
        read-only mount fail <code class="font-[var(--font-mono)] text-sm">EROFS</code> at the mode
        gate, above the backend; <code class="font-[var(--font-mono)] text-sm">TEBAKO_MOUNT_RW</code>{' '}
        stays <code class="font-[var(--font-mono)] text-sm">ENOTSUP</code> in-tree. LimniFS's own
        AEAD-sealed images are an image-format concern — a mount of one without key support fails{' '}
        <code class="font-[var(--font-mono)] text-sm">ENOTSUP</code> by name; tebako-side encryption
        stays the spec-10 transform. And the in-image manifest never names a format: payload
        artifacts stay <code class="font-[var(--font-mono)] text-sm">.tfs</code>-named and
        byte-identical with the registry artifact whatever the backend.
      </p>
    </div>

    <!-- ============ THREE NEIGHBORS ============ -->
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      <a href="/docs/architecture/vfs/" class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
        <p class="tb-eyebrow">NEXT · THE VFS</p>
        <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">The virtual filesystem</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          The mount table, longest-prefix dispatch, and the backend seam these formats sit behind.
        </p>
      </a>
      <a href="/docs/architecture/overlays/" class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
        <p class="tb-eyebrow">NEXT · OVERLAYS</p>
        <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">Declarative overlays</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          The COW and ENC transforms that stack above any backend — declared, never silent.
        </p>
      </a>
      <a href="/docs/architecture/wire-format/" class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
        <p class="tb-eyebrow">NEXT · WIRE FORMAT</p>
        <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">The tpkg wire format</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          The 166-byte trailer and slot records that carry the format_id hint.
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
