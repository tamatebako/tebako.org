---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import StatusPill from '../../../components/docs/StatusPill.astro'

const GH = 'https://github.com/tamatebako'
const LINKS = {
  product: `${GH}/tebako`,
  productReleases: `${GH}/tebako/releases`,
  crates: `${GH}/tebako/tree/main/crates`,
  spec13: `${GH}/tebako/blob/main/docs/spec/13-factories-and-releases.md`,
  spec14: `${GH}/tebako/blob/main/docs/spec/14-process.md`,
  ciYml: `${GH}/tebako/blob/main/.github/workflows/ci.yml`,
  releaseYml: `${GH}/tebako/blob/main/.github/workflows/release.yml`,
  parityDoc: `${GH}/tebako/blob/main/docs/parity.md`,
  contractTests: `${GH}/tebako/tree/main/tests/contract`,
  sizeCommit: `${GH}/tebako/commit/e3005cdcd524a7c4ab62f8e9d8c2cc863554a976`,
  libtfsRel: `${GH}/libtfs/releases/tag/v0.13.0`,
  cppBootstrapRel: `${GH}/tebako-bootstrap/releases/tag/v0.2.0`,
  packagesOrg: 'https://github.com/tebako-packages',
  packagesIndex: 'https://github.com/tebako-packages/index',
}
const crateHref = (name: string) => `${LINKS.crates}/${name}`

const repos = [
  {
    name: 'tebako',
    href: LINKS.product,
    role: 'THE PRODUCT. The Rust workspace and nothing else: the five shipped binaries (tebako, tfs, tebako-pkg, tebako-shim, tebako-bootstrap) plus every library crate behind them — wire format, VFS, resolver, driver, signer. Publishes its own per-platform releases across seven triplets.',
    state: 'Product — releases ship',
  },
  {
    name: 'ruby',
    href: `${GH}/ruby`,
    role: 'SOURCE FACTORY. Canonical ruby patches + versions.yml; every upstream fetch sha256-verified; a daily monitor onboards new ruby-lang.org releases or files a named drift issue. Publishes tfs-ruby-<ver>-src[-<scenario>].tar.gz + SHA256SUMS. Ruby tooling around vendored upstream C — the patches are the only tebako-specific C consumers.',
    state: 'Factory — active',
  },
  {
    name: 'tebako-runtime-ruby',
    href: `${GH}/tebako-runtime-ruby`,
    role: 'RUNTIME FACTORY. Builds the patched source per (ruby version × triplet), boot-smokes each built runtime, and publishes the two runtime artifacts — interpreter exe + env .tfs image — with manifest.json + SHA256SUMS. Consumes only the source factory\u2019s releases.',
    state: 'Factory — active',
  },
  {
    name: 'dwarfs-t',
    href: `${GH}/dwarfs-t`,
    role: 'The ONLY tebako-owned C++: the DwarFS-T image format library (FlatBuffers metadata — upstream dwarfs cannot read it) behind the dwarfs_c_* C ABI. Read-only at runtime forever; the Writer exists at creation time only. Never archived — the foundation, not a legacy repo.',
    state: 'Foundation — active',
  },
  {
    name: 'dwarfs-t-rs',
    href: `${GH}/dwarfs-t-rs`,
    role: 'Standalone Rust binding to dwarfs-t: the safe crate (reader + in-process Writer) over the hand-pinned FFI sys crate. Not tebako-specific — the product consumes it as an ordinary external dependency.',
    state: 'Foundation — active',
  },
  {
    name: 'tebako-ci-containers',
    href: `${GH}/tebako-ci-containers`,
    role: 'The Docker toolchain images the factories build in.',
    state: 'Tooling — active',
  },
  {
    name: 'tebako.org',
    href: `${GH}/tebako.org`,
    role: 'This site: the docs, the blog, and the trust-anchor publication point.',
    state: 'Site — active',
  },
  {
    name: 'tebako-packages/*',
    href: LINKS.packagesOrg,
    role: 'The feedstock org, conda-forge model: one repo per package (recipe + patch sets + manifest templates + CI), each owning its own release line. A feedstock\u2019s releases host its payload artifacts + its tpkg-registry.yaml; the index repo is the registry-of-registries behind tebako add-registry.',
    state: 'Org — active',
  },
  {
    name: 'tebako-v1',
    href: `${GH}/tebako-v1`,
    role: 'The C++/gem era, frozen: the gem press, the C++ tebako-main driver, the merged env+app image model. Kept readable as the behavioral reference and the history. Nothing new lands there — do not touch.',
    state: 'Retired',
  },
  {
    name: 'libtfs',
    href: `${GH}/libtfs`,
    role: 'The C++ tebako_fs_* engine the Rust tfs crate superseded. No new features — it stays because product CI still downloads its released binaries (tebakofs, mkdwarfs) as the golden-parity oracle.',
    state: 'Oracle — maintenance',
  },
  {
    name: 'tebako-bootstrap',
    href: `${GH}/tebako-bootstrap`,
    role: 'The C99 v1 launcher. Same arrangement: frozen, and still downloaded by product CI as the Rust bootstrap\u2019s behavioral oracle and the printed size baseline.',
    state: 'Oracle — maintenance',
  },
]

const crateGroups = [
  {
    group: 'The wire',
    crates: [
      { name: 'tpkg', what: 'the tpkg trailer + manifest format — parse, serialize, validate. The single source of truth for the wire format; #![forbid(unsafe_code)].' },
      { name: 'tebako-json', what: 'minimal exact-format JSON — writer + small parser, no serde.' },
      { name: 'tebako-log', what: 'the stack\u2019s one debug facility — TEBAKO_DEBUG levels, stderr/file sinks, component filters.' },
    ],
  },
  {
    group: 'The VFS',
    crates: [
      { name: 'tfs', what: 'libtfs-rs: the tebako_fs_* C ABI in Rust (cdylib/staticlib). The shipping TFS implementation — the C++ libtfs is its parity oracle.' },
      { name: 'sqfs-sys', what: 'hand-pinned FFI to libsquashfs (squashfs-tools-ng), same discipline as dwarfs-t-sys.' },
      { name: 'libtfs-preload', what: 'the preload interposition shim — DYLD_INSERT_LIBRARIES / LD_PRELOAD VFS injection for dynamic native binaries.' },
    ],
  },
  {
    group: 'The CLI surface (four of the five binaries)',
    crates: [
      { name: 'tebako-cli', what: 'the tebako binary — press / run / install / publish / check / trace / cache / info.' },
      { name: 'tfs-cli', what: 'the tfs binary — the generic VFS image tool: info / ls / tree / cat / extract / find / mkimage / exec.' },
      { name: 'tebako-pkg', what: 'tpkg trailer surgery — bundle / unbundle / insert-image / set-runtime / sign / verify / validate / info.' },
      { name: 'tebako-shim', what: 'the dispatcher + version manager — argv0 resolution, the version chain, runtime resolution, the handoff.' },
    ],
  },
  {
    group: 'Load time',
    crates: [
      { name: 'tebako-bootstrap', what: 'the Rust loader — the fifth binary and the process entry point of every stitched package. Size-gated, below.' },
      { name: 'tebako-driver', what: 'the spec-17 driver linked inside every runtime exe: mounts the env image + payload images, applies the jail, rewrites argv. The Rust successor of the v1 C++ tebako-main.' },
    ],
  },
  {
    group: 'Shared plumbing',
    crates: [
      { name: 'tebako-resolve', what: 'MECE payload references, transport-agnostic fetchers, the shared payload cache.' },
      { name: 'tebako-http', what: 'in-process HTTPS — ureq + rustls, webpki-roots bundled. No curl anywhere.' },
      { name: 'tebako-signer', what: 'OpenPGP sign/verify via rnp-rs, vendored — no system librnp provisioning.' },
      { name: 'tebako-info', what: 'the info/inspect surface — payload and package introspection as JSON documents.' },
      { name: 'tebako-term', what: 'terminal progress — TTY detect, hand-rolled ANSI bar/spinner, zero dependencies.' },
      { name: 'tebako-arscope', what: 'scopes Rust staticlib symbols for single-link embedding (the yjit-collision seal), pure Rust, no shell-outs.' },
    ],
  },
]

const sizeHistory = [
  {
    era: 'C99 bootstrap v0.2.0 — the baseline, six platform binaries',
    gate: '—',
    measured: '32,512–908,112 B',
  },
  {
    era: 'Rust bootstrap ships, downloads via curl',
    gate: '< 2 MB',
    measured: '371,776 B (macOS arm64)',
  },
  {
    era: 'Downloads go in-process (tebako-http)',
    gate: '< 3 MB — owner-raised when curl was dropped',
    measured: '1,238,384 B macOS arm64 · 1,664,336 B ubuntu (+867 KB of TLS stack)',
  },
  {
    era: 'Full static botan ships in the bootstrap',
    gate: '< 6 MB — temporary, owner 2026-07-27',
    measured: '—',
  },
  {
    era: 'Today — crypto feature-gated OUT of the shipped bootstrap (unverified-first)',
    gate: '< 3 MB, hard fail',
    measured: 'per-platform table on every CI run, printed next to the C99 baseline',
  },
]

const successors = [
  { v1: 'the tebako gem (press orchestrator)', v2: 'crates/tebako-cli' },
  { v1: 'the C99 bootstrap', v2: 'crates/tebako-bootstrap' },
  { v1: 'C++ libtfs (shipping VFS)', v2: 'crates/tfs' },
  { v1: 'the C++ tebako-main driver', v2: 'crates/tebako-driver (linked into the runtime)' },
]
---
<!-- normative: spec 13, spec 14 — wave-1 rewrite 2026-08-25. Repo set + states verified live via api.github.com; crate map from `cargo metadata` on tebako main (workspace 0.2.4); five binaries + triplets from .github/workflows/release.yml; size-gate history from ci.yml + commit e3005cd + the tebako-bootstrap v0.2.0 release asset sizes. -->

<DocsLayout
  section="architecture"
  href="/docs/architecture/repositories/"
  title="The repositories"
  heading="The repository map."
  description="Every tamatebako repository and its lifecycle state, plus the product repo's crate map, the bootstrap size gate, and the golden-parity discipline."
>
  <p slot="lede" class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      The ecosystem is a fleet of small repos, each owning one artifact and one contract.
      They consume each other's published releases, never source trees — so every repo
      builds its own platforms and publishes its own releases
      (<a href={LINKS.spec13} class="tb-link-underline text-[var(--tb-c-accent)]">spec 13</a>).
      Retired repos stay readable; oracle repos stay frozen; neither is a graveyard.
    </p>

    <!-- ============ THE MAP ============ -->
    <div class="mt-12 overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
      <table class="w-full min-w-[820px] text-left text-sm">
        <thead>
          <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
            <th class="px-5 py-3 font-medium">REPO</th>
            <th class="px-5 py-3 font-medium">ROLE</th>
            <th class="px-5 py-3 font-medium">STATE</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--tb-c-divider)]">
          {repos.map((r) => (
            <tr>
              <td class="px-5 py-3 font-[var(--font-mono)] text-xs whitespace-nowrap">
                <a href={r.href} class="tb-link-underline text-[var(--tb-c-accent)]">{r.name}</a>
              </td>
              <td class="px-5 py-3 text-[var(--tb-c-text-2)]">{r.role}</td>
              <td class="px-5 py-3 whitespace-nowrap">
                <span class="font-[var(--font-mono)] text-xs text-[var(--tb-c-text-2)]">{r.state}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 max-w-2xl text-sm text-[var(--tb-c-text-3)]">
      Also in the tamatebako org, outside the stack itself: tebako-samples (packaging
      tutorials), fmem (a v1-era libc-streams dependency the modern stack no longer
      consumes), and aibika (a separate Windows Ruby application packager — not part
      of tebako).
    </p>

    <!-- ============ THE PRODUCT REPO ============ -->
    <div class="mt-16">
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <h2>The product repository.</h2>
        <StatusPill status="shipped" note="v0.2.x · five binaries × seven triplets" />
      </div>
      <p class="max-w-2xl text-[var(--tb-c-text-2)]">
        <a href={LINKS.product} class="tb-link-underline font-medium text-[var(--tb-c-accent)]">tamatebako/tebako</a>
        {' '}is one Rust workspace and the whole product: no C/C++, no shell-outs, no system
        dependencies in anything it ships. Each release publishes the five binaries —
        <code class="font-[var(--font-mono)] text-xs">tebako</code>,{' '}
        <code class="font-[var(--font-mono)] text-xs">tfs</code>,{' '}
        <code class="font-[var(--font-mono)] text-xs">tebako-pkg</code>,{' '}
        <code class="font-[var(--font-mono)] text-xs">tebako-shim</code>,{' '}
        <code class="font-[var(--font-mono)] text-xs">tebako-bootstrap</code> — for
        macOS arm64/x86_64, linux-gnu x86_64/arm64, linux-musl x86_64/arm64, and windows
        ucrt64, with SHA256SUMS + manifest.json. Every leg proves its staged binaries
        before any upload: a bare launch in the cleanest environment the leg claims,
        plus a hard dynamic-dependency whitelist audit
        (<a href={LINKS.releaseYml} class="tb-link-underline text-[var(--tb-c-accent)]">release.yml</a>).
      </p>
      <p class="mt-3 max-w-2xl text-sm text-[var(--tb-c-text-3)]">
        Stated plainly: releases are unsigned-first today — SHA256SUMS + manifest.json
        ship from day one, detached OpenPGP signatures slot in later without restructuring.
        The brew formula tracks the same five binaries.
      </p>

      <h3 class="mb-6 mt-10 font-[var(--font-display)] text-lg font-medium">The crate map.</h3>
      <div class="space-y-4">
        {crateGroups.map((g) => (
          <div class="rounded-2xl border border-[var(--tb-c-divider)] p-6" style="background: var(--tb-c-bg-soft);">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--tb-c-text-3)]">{g.group}</p>
            <div class="mt-3 space-y-2">
              {g.crates.map((c) => (
                <p class="text-sm leading-relaxed text-[var(--tb-c-text-2)]">
                  <a href={crateHref(c.name)} class="tb-link-underline font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">{c.name}</a>
                  {' '}— {c.what}
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-4 max-w-2xl text-sm text-[var(--tb-c-text-3)]">
        Beside the workspace, not in it: <a href={`${GH}/dwarfs-t-rs`} class="tb-link-underline text-[var(--tb-c-accent)]">dwarfs-t-rs</a>,
        the standalone Rust binding to dwarfs-t — consumed as an ordinary external
        dependency, tracking dwarfs-t releases. dwarfs-t itself stays C++ forever;
        the <code class="font-[var(--font-mono)] text-xs">dwarfs_c_*</code> C ABI is the
        only Rust-consumable surface.
      </p>
    </div>

    <!-- ============ SIZE GATE ============ -->
    <div class="mt-16">
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <h2>The bootstrap size gate.</h2>
        <StatusPill status="shipped" note="hard fail ≥ 3 MB" />
      </div>
      <p class="max-w-2xl text-[var(--tb-c-text-2)]">
        The bootstrap is the process entry point of every stitched package, so its size is
        a hard CI gate, not a nice-to-have — a spec-00 invariant. Every
        {' '}<a href={LINKS.ciYml} class="tb-link-underline text-[var(--tb-c-accent)]">CI run</a>
        {' '}builds the release bootstrap per platform, prints it next to the C99 v0.2.0
        baseline, and fails at 3,145,728 bytes. The discipline that keeps it there:{' '}
        <code class="font-[var(--font-mono)] text-xs">opt-level="z"</code>, fat LTO, one
        codegen unit, <code class="font-[var(--font-mono)] text-xs">panic="abort"</code>,
        stripped symbols; no async runtime, no clap, no logging framework
        (<a href={LINKS.spec14} class="tb-link-underline text-[var(--tb-c-accent)]">spec 14</a>).
        The budget moved as the feature set did — and the moves are on record, not swept under:
      </p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">ERA</th>
              <th class="px-5 py-3 font-medium">GATE</th>
              <th class="px-5 py-3 font-medium">MEASURED</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            {sizeHistory.map((s) => (
              <tr>
                <td class="px-5 py-3 text-[var(--tb-c-text-2)]">{s.era}</td>
                <td class="px-5 py-3 font-[var(--font-mono)] text-xs text-[var(--tb-c-text-2)]">{s.gate}</td>
                <td class="px-5 py-3 font-[var(--font-mono)] text-xs text-[var(--tb-c-text-2)]">{s.measured}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-[var(--tb-c-text-3)]">
        The in-process-downloads step and its byte counts are recorded in the{' '}
        <a href={LINKS.sizeCommit} class="tb-link-underline text-[var(--tb-c-accent)]">M7a commit</a>;
        the C99 baseline numbers are the published{' '}
        <a href={LINKS.cppBootstrapRel} class="tb-link-underline text-[var(--tb-c-accent)]">v0.2.0 release assets</a>.
      </p>
    </div>

    <!-- ============ GOLDEN PARITY ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The golden-parity discipline.</h2>
      <p class="max-w-2xl text-[var(--tb-c-text-2)]">
        The order is law (<a href={LINKS.spec14} class="tb-link-underline text-[var(--tb-c-accent)]">spec 14</a>):
        if a C++ or gem predecessor exists, golden vectors and fixtures are generated from
        it <em>first</em> — no oracle, no parity claim. Then the ported corpus runs unchanged
        against the Rust implementation, and parity legs diff byte-for-byte. That is not a
        README promise; it is what CI does on every run:
      </p>
      <ul class="mt-6 max-w-2xl list-disc space-y-2 pl-6 text-[var(--tb-c-text-2)] marker:text-[var(--tb-c-accent)]">
        <li>
          CI downloads the C++ oracle binaries — <code class="font-[var(--font-mono)] text-xs">tebakofs</code> and{' '}
          <code class="font-[var(--font-mono)] text-xs">mkdwarfs</code> from{' '}
          <a href={LINKS.libtfsRel} class="tb-link-underline text-[var(--tb-c-accent)]">libtfs v0.13.0</a>,
          and the <a href={LINKS.cppBootstrapRel} class="tb-link-underline text-[var(--tb-c-accent)]">C99 bootstrap v0.2.0</a> —
          and diffs tebako-pkg / tfs-cli / tebako-bootstrap behavior against them byte-for-byte.
        </li>
        <li>
          tebako-cli's golden e2e presses side-by-side with the reference gem: same fixture,
          same prefix — the press stdout and the packaged binaries' output are diffed.
        </li>
        <li>
          The C++ libtfs test corpus, ported to run through the Rust C ABI, lives in{' '}
          <a href={LINKS.contractTests} class="tb-link-underline text-[var(--tb-c-accent)]">tests/contract</a>;
          {' '}<a href={LINKS.parityDoc} class="tb-link-underline text-[var(--tb-c-accent)]">docs/parity.md</a>
          {' '}is the audit of what was ported and why.
        </li>
        <li>
          An exported-symbol audit passes only when nothing but the{' '}
          <code class="font-[var(--font-mono)] text-xs">tebako_*</code> surface leaks.
        </li>
        <li>
          Anything ported from a C++/gem predecessor is byte-compared, or the deviation is
          documented. A mismatch means the contract moved — and both sides must move together.
        </li>
      </ul>
      <p class="mt-6 max-w-2xl text-[var(--tb-c-text-2)]">
        This is why the two oracle repos are not archived: the parity claim needs the oracle
        to exist. libtfs and the C99 bootstrap get no new features — they stay frozen,
        citable, and downloaded by the product's own CI.
      </p>
    </div>

    <!-- ============ RETIRED ============ -->
    <div class="mt-16">
      <h2 class="mb-3">What retired: tebako-v1.</h2>
      <p class="max-w-2xl text-[var(--tb-c-text-2)]">
        The whole v1 implementation — the gem press, the C99 bootstrap as the shipped
        product, the C++ driver, the merged env+app image model — is frozen in{' '}
        <a href={`${GH}/tebako-v1`} class="tb-link-underline text-[var(--tb-c-accent)]">tebako-v1</a>.
        It stays readable: it is the behavioral reference the parity story is proven
        against, and the history of why v2 looks the way it does. Nothing new lands there.
        The piece-by-piece succession:
      </p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">V1 (RETIRED)</th>
              <th class="px-5 py-3 font-medium">V2 (SHIPPING)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            {successors.map((s) => (
              <tr>
                <td class="px-5 py-3 text-[var(--tb-c-text-2)]">{s.v1}</td>
                <td class="px-5 py-3 font-[var(--font-mono)] text-xs text-[var(--tb-c-text-2)]">{s.v2}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- ============ LIFECYCLE RULES ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The lifecycle rules.</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">Contracts outlive implementations</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            The <code class="font-[var(--font-mono)] text-xs">tebako_fs_*</code> ABI and the tpkg
            trailer are byte-level contracts. Consumers don't care which repo ships them — that
            is what let the Rust reimplementation ship without a flag day, and it is why the
            C++ side still matters as the oracle.
          </p>
        </div>
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">Releases are the interface</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            Repos consume each other's published releases, never source trees. The factories
            and the product live in different repos with separate cadences — the manifest.json
            contract sits between them, so the packager never hardcodes a runtime matrix.
          </p>
        </div>
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">C++ exactly once</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            dwarfs-t is the only tebako-owned C++ (upstream ruby's own C is vendored upstream
            source, built in the two factories). Everything else is Rust, pure Ruby tooling,
            or Docker — no exceptions, no "temporary" ports.
          </p>
        </div>
        <div class="tb-card p-6">
          <h3 class="font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-accent)]">dwarfs-t is not legacy</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            A Rust DwarFS reader/writer is explicitly out of scope. dwarfs-t is read-only at
            runtime forever, with the Writer at creation time only; the only Rust-consumable
            surface is the C ABI, co-versioned with the C++ it wraps — which is what
            dwarfs-t-rs binds.
          </p>
        </div>
