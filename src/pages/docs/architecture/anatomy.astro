            <g transform="translate(260, 222)"><rect width="200" height="30" rx="6" fill="var(--tb-c-card)" stroke="var(--tb-c-divider-strong)" /><text x="100" y="19" text-anchor="middle" fill="var(--tb-c-text-2)">aarch64-linux-musl · static</text></g>
