---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import StatusPill from '../../../components/docs/StatusPill.astro'

const LINKS = {
  spec17: 'https://github.com/tamatebako/tebako/blob/main/docs/spec/17-runtime-driver-contract.md',
  driverCrate: 'https://github.com/tamatebako/tebako/tree/main/crates/tebako-driver',
  bootstrapCrate: 'https://github.com/tamatebako/tebako/tree/main/crates/tebako-bootstrap',
  tpkgCrate: 'https://github.com/tamatebako/tebako/tree/main/crates/tpkg',
}

const exitRows = [
  { code: '65', name: 'EX_TEBAKO_MANIFEST', when: 'corrupt or internally inconsistent tpkg trailer / package manifest; malformed TEBAKO_MOUNT_ROOT; the --tebako-entry not present in the established mounts; a co-mounted image with a corrupt in-image manifest', who: 'bootstrap · driver' },
  { code: '66', name: 'EX_TEBAKO_ABI', when: 'the package declares a launcher ABI this loader does not speak', who: 'bootstrap' },
  { code: '67', name: 'EX_TEBAKO_RUNTIME_REF', when: 'the runtime_ref is unparseable (type / version / constraint grammar)', who: 'bootstrap' },
  { code: '68', name: 'EX_TEBAKO_OVERLAY', when: 'an overlay/decrypt binding failed — unbound retained store, missing or non-opening key material, unwritable store, orphan binding, malformed TEBAKO_OVERLAYS / TEBAKO_DECRYPT', who: 'resolver · driver mount path' },
  { code: '69', name: 'EX_TEBAKO_UNAVAILABLE', when: 'the runtime cannot be obtained — download failed, or TEBAKO_OFFLINE=1 without a cache hit', who: 'bootstrap' },
  { code: '70', name: 'EX_TEBAKO_SHA', when: 'sha256 mismatch on a downloaded artifact (exe, env image, dll) against the release index', who: 'bootstrap' },
  { code: '71', name: 'EX_TEBAKO_SIGNATURE', when: 'a signed package\u2019s signature fails verification (strict, always)', who: 'bootstrap' },
  { code: '72', name: 'EX_TEBAKO_TRUST', when: 'the signer\u2019s key is not in the trust store — or TEBAKO_REQUIRE_SIGNED=1 meets an unsigned package', who: 'bootstrap · install path' },
  { code: '73', name: 'EX_TEBAKO_JAIL', when: 'the jail policy is malformed or unusable — parsed and applied after the mounts, never before them', who: 'driver' },
  { code: '74', name: 'EX_TEBAKO_IO', when: 'host I/O failure on cache/install/lock paths', who: 'bootstrap · resolve' },
  { code: '75', name: 'EX_TEBAKO_CONTRACT', when: 'the runtime is pre-era (declares no contract set) or speaks a contract the loader refuses — fail-closed before any install or execute', who: 'bootstrap' },
  { code: '76', name: 'EX_TEBAKO_INSTALL', when: 'a store install cannot complete (lock timeout, digest anchors disagree, partial state that tmp+rename cannot hide)', who: 'resolve · cli' },
  { code: '77', name: 'EX_TEBAKO_CONTRACT_ERA', when: 'package/payload contract-era mismatch in either direction — any trailer or manifest reader', who: 'tpkg · pkg · cli' },
  { code: '78', name: 'EX_TEBAKO_LAYOUT', when: 'env-image layout mismatch — a mount_root override the image never granted, a missing preload-shim grant, an interp ABI pair the image does not declare; also the preload shim\u2019s EX_CONFIG', who: 'driver · libtfs-preload' },
  { code: '79', name: 'EX_TEBAKO_CHECK', when: 'a payload check FAILed — the verdict line names the check and the failed expectation (SKIP never fails the aggregate)', who: 'tebako check' },
]
---
<!-- normative: spec 17 (normative contract), spec 18 §7, spec 06 §4 — exit rows verified against crates/tpkg/src/lib.rs:272-291, crates/tebako-bootstrap/src/lib.rs:81-106, crates/tebako-driver/src/lib.rs:55-64, crates/libtfs-preload/src/spec.rs:18 (tebako main, 2026-08-25) -->

<DocsLayout
  section="architecture"
  href="/docs/architecture/driver-contract/"
  title="The driver contract"
  heading="The driver contract."
  description="The normative wire between the tebako loader and any runtime: --tebako-image triples, --tebako-entry, the handoff environment, mount ordering and modes, and the complete named exit-code table."
>
    <p slot="lede" class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      The <strong>driver</strong> is the code inside every runtime executable that mounts the
      environment image and the payload slices, applies the jail, and rewrites argv to the
      entrypoint. This page is the wire it speaks — language-agnostic by construction:
      ruby is the first runtime; python or julia follow{' '}
      <a href={LINKS.spec17} class="tb-link-underline font-medium text-[var(--tb-c-accent)]">the same contract</a>
      {' '}unchanged.
    </p>

    <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-[var(--tb-c-divider)] px-5 py-4" style="background: var(--tb-c-bg-soft);">
      <StatusPill status="shipped" />
      <span class="text-sm text-[var(--tb-c-text-2)]">
        the reference implementation is{' '}
        <a href={LINKS.driverCrate} class="tb-link-underline text-[var(--tb-c-accent)]">crates/tebako-driver</a>
        {' '}(Rust, staticlib + rlib); the v1 C++ tebako-main driver is retired
      </span>
    </div>

    <!-- ============ INVOCATION SURFACE ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The invocation surface.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        One grammar, every platform. Everything before the first{' '}
        <code class="font-[var(--font-mono)] text-sm">--tebako-*</code> is the loader's; everything
        after <code class="font-[var(--font-mono)] text-sm">--tebako-entry</code> is the user's,
        verbatim. An unknown <code class="font-[var(--font-mono)] text-sm">--tebako-*</code> flag is
        a named error, never silently ignored.
      </p>
      <pre class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)] p-6 font-[var(--font-mono)] text-xs leading-relaxed text-[var(--tb-c-text-2)] sm:text-sm" style="background: var(--tb-c-bg-soft);"><code>&lt;runtime&gt; --tebako-image &lt;self|image-path&gt;:&lt;slot|-&gt;:&lt;mount&gt; ...
          [--tebako-trace &lt;host-path&gt;]
          --tebako-entry &lt;argv0&gt; &lt;user args...&gt;

  &lt;self&gt;       the running executable's own package file; &lt;slot&gt; picks the
              trailer-described region
  &lt;image-path&gt;  a standalone file — BARE (no trailer): slot 0 ≡ - ≡ whole file;
              PACKAGED: numeric slot only, "-" is a named error
  &lt;mount&gt;      a POSIX absolute path on EVERY platform — on windows the driver
              qualifies it onto the runtime root's drive (A:/t/…) before mounting;
              a declared mount naming a drive is malformed</code></pre>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-[var(--tb-c-divider)] p-6" style="background: var(--tb-c-bg-soft);">
          <p class="font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">MOUNT ORDER + FAILURE RULE</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            The env image mounts first (whole-file, from{' '}
            <code class="font-[var(--font-mono)] text-xs">TEBAKO_RUNTIME_IMAGE</code>), then payload
            triples in argv order. The table is longest-prefix; nested mounts are legal; a duplicate
            exclusive mount point is <code class="font-[var(--font-mono)] text-xs">EEXIST</code>.
            Any failure unmounts everything — <strong>never a partial mount</strong>. A runtime-role
            slot (<code class="font-[var(--font-mono)] text-xs">format_id&nbsp;=&nbsp;4</code>) is
            never mounted.
          </p>
        </div>
        <div class="rounded-2xl border border-[var(--tb-c-divider)] p-6" style="background: var(--tb-c-bg-soft);">
          <p class="font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">MOUNT MODES</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
            Every mount is <strong>exclusive</strong> (default) or <strong>union</strong>, declared
            per slot in the package manifest's <code class="font-[var(--font-mono)] text-xs">mounts:</code>
            {' '}block — never on the argv wire, so the launcher ABI is unchanged and older drivers
            refuse a union package loudly. Union conflicts resolve by declared precedence
            (<code class="font-[var(--font-mono)] text-xs">after-env</code> or{' '}
            <code class="font-[var(--font-mono)] text-xs">after:&lt;slot&gt;</code>); the union set is
            journaled at boot. Shim-dispatched payloads (no package manifest) are always exclusive.
          </p>
        </div>
      </div>
    </div>

    <!-- ============ ENTRY ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The entry, and the argv rewrite.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        <code class="font-[var(--font-mono)] text-sm">--tebako-entry</code> separates loader args
        from user args. The entry resolves against the <strong>first</strong>{' '}
        <code class="font-[var(--font-mono)] text-sm">--tebako-image</code> mount (the app payload) —
        or the runtime root when no image spec is given — and the driver verifies its presence
        against the mounts the boot itself established (named 65 when absent). A bare NAME with
        no <code class="font-[var(--font-mono)] text-sm">/</code> (e.g.{' '}
        <code class="font-[var(--font-mono)] text-sm">ruby</code>) is the interpreter keyword: the
        boot starts the interpreter itself and drops the keyword. With images but no entry at all,
        the boot mounts and starts the interpreter with its own args (the smoke form).
      </p>
      <p class="max-w-3xl text-[var(--tb-c-text-2)]">
        On success the process argv is replaced with{' '}
        <code class="font-[var(--font-mono)] text-sm">[&lt;original argv0&gt;, &lt;entry resolved in the VFS&gt;, &lt;user args…&gt;]</code>
        {' '}— the program name stays at index 0, so the interpreter parses its argv conventionally
        and takes the entry as its script. The jail installs <em>after</em> the mounts;{' '}
        <code class="font-[var(--font-mono)] text-sm">--tebako-trace</code> arms the trace bus
        <em>before</em> any mount (a channel that cannot be opened is a loud stderr note and a
        disarmed bus — observability never gates a boot).
      </p>
    </div>

    <!-- ============ MOUNT ROOT ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The mount root is a default, not a constant.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        The runtime root is a per-platform baked default owned by the runtime factory (ruby:{' '}
        <code class="font-[var(--font-mono)] text-sm">/__tfs__</code> on POSIX,{' '}
        <code class="font-[var(--font-mono)] text-sm">A:/t</code> on windows) — it flows from the
        source patches through the factory into the exe, and nothing downstream re-authors it.{' '}
        <code class="font-[var(--font-mono)] text-sm">TEBAKO_MOUNT_ROOT</code> redirects the env-image
        mount at boot:
      </p>
      <div class="rounded-2xl border border-[var(--tb-c-divider)] p-6" style="background: var(--tb-c-bg-soft);">
        <p class="font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">THE OVERRIDE, STATED PLAINLY</p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          Validated before any mount — absolute, no trailing slash, no{' '}
          <code class="font-[var(--font-mono)] text-xs">..</code>; a malformed value is{' '}
          <strong>exit 65</strong> naming the variable. Then gated post-mount on the env image's
          layout grant (<code class="font-[var(--font-mono)] text-xs">mount_root_override: true</code>):
          an image without the grant predates the override era (its rbconfig is pinned to the baked
          root), so the driver refuses with <strong>exit 78</strong> naming both the override and the
          image — never a boot whose load paths point at an unmounted root. Era-2 rbconfig emits{' '}
          <code class="font-[var(--font-mono)] text-xs">ENV["TEBAKO_MOUNT_ROOT"] || &lt;baked&gt;</code>,
          so the interpreter follows.
        </p>
      </div>
    </div>

    <!-- ============ HANDOFF ENVIRONMENT ============ -->
    <div class="mt-16">
      <h2 class="mb-3">The handoff environment.</h2>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        The loader speaks to the driver through a small, fixed set of variables. Every one is a
        single-owner flow — declared by the factory or the manifest, consumed verbatim, never
        re-authored downstream. The exhaustive table (every <code class="font-[var(--font-mono)] text-sm">TEBAKO_*</code>
        {' '}variable in the system) lives in the reference section; these are the contract's own:
      </p>
      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">VARIABLE</th>
              <th class="px-5 py-3 font-medium">MEANING</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            <tr><td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">TEBAKO_RUNTIME_IMAGE</td><td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">absolute path of the runtime's own env .tfs — mounted whole at the runtime root, first, before any payload triple</td></tr>
            <tr><td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">TEBAKO_TFS_MOUNTS</td><td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">image:mount,… — the mount table a spawned child re-establishes through the preload shim (the spawn-hook path)</td></tr>
            <tr><td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">TEBAKO_JAIL</td><td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">the jail policy env form — enforced by the driver, installed after the mounts; malformed is exit 73</td></tr>
            <tr><td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">TEBAKO_TRACE / --tebako-trace</td><td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">the trace bus channel (JSONL), armed at boot before any mount; the argument wins when both are set; never policy-gated</td></tr>
            <tr><td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">TEBAKO_MOUNT_&lt;SLUG&gt;</td><td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">per co-mounted payload, its physical mount point (/tools/inkscape → TEBAKO_MOUNT_TOOLS_INKSCAPE); two mounts slugging alike is a named 65; the root mount exports nothing</td></tr>
            <tr><td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">PATH</td><td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">rebuilt by the boot: launcher wrap-bin dir → co-mounted dependency bin dirs (from each image's own manifest, in triple order; the app payload never contributes) → windows alias dirs → the inherited PATH. A corrupt manifest or unmaterializable declared executable is a named 65</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ============ EXIT CODES ============ -->
    <div class="mt-16">
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <h2>The named exit codes.</h2>
        <StatusPill status="shipped" note="one table, no silent fallbacks" />
      </div>
      <p class="mb-6 max-w-3xl text-[var(--tb-c-text-2)]">
        Loader-side failures keep the loader's named codes; runtime-side failures use the
        interpreter's own codes. There is no catch-all and no code does double duty — the shared
        constants live in{' '}
        <a href={LINKS.tpkgCrate} class="tb-link-underline text-[var(--tb-c-accent)]">crates/tpkg</a>
        {' '}and every emitter references them.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-[var(--tb-c-divider)]" style="background: var(--tb-c-bg-soft);">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead>
            <tr class="border-b border-[var(--tb-c-divider-strong)] font-[var(--font-mono)] text-xs text-[var(--tb-c-text-3)]">
              <th class="px-5 py-3 font-medium">CODE</th>
              <th class="px-5 py-3 font-medium">NAME</th>
              <th class="px-5 py-3 font-medium">RAISED WHEN</th>
              <th class="px-5 py-3 font-medium">EMITTER</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tb-c-divider)]">
            {exitRows.map((r) => (
              <tr>
                <td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs font-medium text-[var(--tb-c-accent)]">{r.code}</td>
                <td class="px-5 py-2.5 align-top font-[var(--font-mono)] text-xs text-[var(--tb-c-text-2)]">{r.name}</td>
                <td class="px-5 py-2.5 text-xs leading-relaxed text-[var(--tb-c-text-2)]">{r.when}</td>
                <td class="px-5 py-2.5 align-top text-xs text-[var(--tb-c-text-3)]">{r.who}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl text-sm text-[var(--tb-c-text-3)]">
        Two out-of-band codes complete the picture: the runtime factory uses <strong>132</strong> for
        a pre-era/corrupt source tarball, and <code class="font-[var(--font-mono)] text-xs">--tebako-extract</code>
        {' '}(the runtime-side option riding the user-arg passthrough) dumps mounted images to disk and
        exits 0. The trace subcommands carry their own verdict codes (0 clean / 1 finding / 2 error) —
        see observability.
      </p>
    </div>

    <!-- ============ CONTRACT VERSION ============ -->
    <div class="mt-16">
      <h2 class="mb-3">Negotiated, fail-closed.</h2>
      <p class="max-w-3xl text-[var(--tb-c-text-2)]">
        A runtime whose driver implements this widened grammar — image-path triples, bare-file slot
        tokens, env-image-first multi-mount, direct entry execution — declares{' '}
        <strong>contract_version 2</strong> in its release manifest, and the compiled-in constant
        (<code class="font-[var(--font-mono)] text-sm">tebako_driver_contract_version()</code>) must
        agree with the manifest. A runtime that declares no contract set is pre-era: the loader
        refuses it by name with exit 75, before any install or execute. Runtime provenance rides the
        payload manifest (<code class="font-[var(--font-mono)] text-sm">provides</code> — engine,
        version, abi_line, platform — plus <code class="font-[var(--font-mono)] text-sm">built_from</code>);
        the dispatcher's compatibility check consumes exactly those fields.
      </p>
    </div>

    <!-- ============ THREE NEIGHBORS ============ -->
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      <a href="/docs/architecture/anatomy/" class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
        <p class="tb-eyebrow">NEXT · ANATOMY</p>
        <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">The anatomy of a package</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          Trailer, slots, extension blocks — the bytes this contract reads.
        </p>
      </a>
      <a href="/docs/architecture/runtime-as-image/" class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
        <p class="tb-eyebrow">NEXT · RUNTIME AS IMAGE</p>
        <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">The two-artifact runtime</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          Exe plus env image — what the driver mounts first, and why.
        </p>
      </a>
      <a href="/docs/architecture/interposition/" class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
        <p class="tb-eyebrow">NEXT · INTERPOSITION</p>
        <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">How native children inherit the VFS</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">
          The spawn hook, the preload shim, and the mounts env the driver exports.
        </p>
      </a>
    </div>
</DocsLayout>
