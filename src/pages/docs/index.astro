---
import BaseLayout from '../../layouts/BaseLayout.astro'
import StatusPill from '../../components/docs/StatusPill.astro'

// IA: PROGRESS/15-website-overhaul.md §B — audience-based landing (wave 0 skeleton)

const audiences = [
  {
    eyebrow: 'I RUN PACKAGES',
    title: 'Run a tebako package',
    href: '/docs/guides/install/',
    desc: 'Download, install, run — no toolchain, no compilation, no libraries to fetch. Shims put packaged commands on your PATH with per-invocation version dispatch.',
  },
  {
    eyebrow: 'I SHIP DATA',
    title: 'Build a data payload',
    href: '/docs/guides/data-payload/',
    desc: 'A directory and a manifest become a versioned, mountable .tfs image — fonts, datasets, any file tree. No compilation machinery required.',
  },
  {
    eyebrow: 'I SHIP APPS',
    title: 'Package an application',
    href: '/docs/guides/package-ruby/',
    desc: 'Press your app into a single executable — lean or fat — then publish it to a registry your users add. You compile only your own code; tebako arrives as binaries.',
  },
  {
    eyebrow: 'I HACK ON TEBAKO',
    title: 'Work on tebako itself',
    href: '/docs/architecture/overview/',
    desc: 'The architecture documentation: the three-part package, the driver contract, the store, the chain of trust, the repo map — and the contributor guide.',
  },
]

const sections = [
  {
    eyebrow: 'GUIDES',
    title: 'How-to guides',
    href: '/docs/guides/',
    desc: 'Task-shaped and copy-paste ready: install, run, press, publish, shim, jail, verify, debug, trace, check, inspect.',
    planned: false,
  },
  {
    eyebrow: 'ARCHITECTURE',
    title: 'Architecture',
    href: '/docs/architecture/overview/',
    desc: 'Concepts and machinery: packages and payloads, the runtime-as-image model, the VFS, factories, stores, and trust.',
    planned: false,
  },
  {
    eyebrow: 'REFERENCE',
    title: 'Reference',
    href: '/docs/reference/',
    desc: 'The CLI surface command by command, environment variables, exit codes, manifest and registry schemas, the spec index.',
    planned: true,
  },
]
---

<BaseLayout title="Documentation — Tebako" description="Tebako documentation by audience: run packages, ship data payloads, package applications, or work on tebako itself — plus how-to guides, architecture docs, and reference material.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-32">
    <p class="tb-eyebrow">DOCUMENTATION</p>
    <h1 class="mt-3">Start where you are.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--tb-c-text-2)]">
      Tebako is a packaging and loading ecosystem: payloads stitched onto a bootstrap,
      runtimes downloaded once and mounted — never extracted. What you need from these
      docs depends on which of those you touch.
    </p>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {audiences.map((a) => (
        <a href={a.href} class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
          <p class="tb-eyebrow">{a.eyebrow}</p>
          <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">{a.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">{a.desc}</p>
        </a>
      ))}
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {sections.map((s) => (
        <a href={s.href} class="group rounded-2xl border border-[var(--tb-c-divider)] p-6 transition-colors hover:border-[var(--tb-c-accent)]" style="background: var(--tb-c-bg-soft);">
          <p class="tb-eyebrow">{s.eyebrow}</p>
          <h3 class="mt-2 font-[var(--font-display)] text-lg font-medium text-[var(--tb-c-text-1)] group-hover:text-[var(--tb-c-accent)]">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--tb-c-text-2)]">{s.desc}</p>
          {s.planned && (
            <p class="mt-4"><StatusPill status="planned" note="section in progress" /></p>
          )}
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm leading-relaxed text-[var(--tb-c-text-3)]">
      Coming from the v1 gem? Start with
      {' '}<a href="/docs/architecture/migration/" class="tb-link-underline font-medium text-[var(--tb-c-accent)]">the migration map</a>,
      {' '}then the <a href="/docs/architecture/migrate-v1-v2/" class="tb-link-underline font-medium text-[var(--tb-c-accent)]">flag-by-flag guide</a>.
    </p>
  </section>
</BaseLayout>
