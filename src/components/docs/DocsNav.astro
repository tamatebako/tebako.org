---
import { getSection, type DocsSectionId } from '../../config/docs'

interface Props {
  section: DocsSectionId
}

const { section } = Astro.props
const sec = getSection(section)
const pathname = Astro.url.pathname
const isActive = (href: string) => pathname === href
---

<!-- Mobile: a collapsed jump menu; 26 wrapped pills cost ~220px of scroll
     before any content on a phone. Pills return at md. -->
<select
  aria-label={`Jump to a page in ${sec.label}`}
  onchange="var u=this.value; if(u) window.location.assign(u);"
  class="tb-docs-jump mt-10 w-full rounded-2xl border border-[var(--tb-c-divider)] px-4 py-3 font-[var(--font-mono)] text-sm text-[var(--tb-c-text-2)] md:hidden"
  style="background: var(--tb-c-bg-soft);"
>
  <option value="">Jump to a page…</option>
  {sec.entries.filter((e) => e.href !== sec.homeHref).map((e) => (
    <option value={e.href} selected={isActive(e.href)}>{e.label}</option>
  ))}
</select>

<nav aria-label={`${sec.label} documentation`} class="mt-10 hidden flex-wrap items-center gap-2 md:flex">
  {sec.entries.map((item, i) => (
    <a
      href={item.href}
      aria-current={isActive(item.href) ? 'page' : undefined}
      title={item.status === 'planned' ? 'Planned — landing with the reference wave' : undefined}
      class:list={[
        'rounded-full px-4 py-2 font-[var(--font-mono)] text-xs font-medium transition-colors duration-200',
        isActive(item.href)
          ? 'bg-[var(--tb-c-text-accent)] text-[var(--color-paper)]'
          : item.status === 'planned'
            ? 'border border-dashed border-[var(--tb-c-divider)] text-[var(--tb-c-text-3)] hover:border-[var(--tb-c-accent)] hover:text-[var(--tb-c-text-accent)]'
            : 'border border-[var(--tb-c-divider)] text-[var(--tb-c-text-2)] hover:border-[var(--tb-c-accent)] hover:text-[var(--tb-c-text-accent)]',
      ]}
    >
      <span class="opacity-60">{String(i + 1).padStart(2, '0')}</span>
      <span class="ml-1.5">{item.label}</span>
    </a>
  ))}
</nav>
