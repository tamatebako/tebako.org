---
---

<!-- Gem badge (hidden until first gem found) -->
<div class="tb-gem-badge" id="tb-gem-badge" style="display:none;" title="Gems collected">
  <span class="tb-gem-badge-icon">◆</span>
  <span class="tb-gem-badge-count">0/8</span>
</div>

<style is:global>
  .tb-gem-badge {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9990;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: var(--tb-c-card);
    border: 1px solid var(--tb-c-divider-strong);
    box-shadow: var(--tb-shadow-card);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--tb-c-text-1);
    cursor: default;
    transition: all 0.4s var(--ease-out-quint, ease);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .tb-gem-badge:hover {
    transform: translateY(-3px);
    border-color: var(--tb-c-accent);
    box-shadow: var(--tb-shadow-card-hover);
  }
  .tb-gem-badge-icon {
    color: var(--tb-c-accent);
    font-size: 0.9rem;
    animation: tb-gem-badge-pulse 2s ease-in-out infinite;
    text-shadow: 0 0 8px currentColor;
  }
  @keyframes tb-gem-badge-pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.25); opacity: 1; }
  }

  .tb-gem-toast {
    position: fixed;
    bottom: 5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9991;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    pointer-events: none;
    white-space: nowrap;
  }
  .dark .tb-gem-toast {
    background: var(--color-ink-soft);
  }

  .tb-kanji-sweep {
    position: fixed;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-gold);
    pointer-events: none;
    z-index: 9992;
    text-shadow: 0 0 24px rgba(248, 184, 131, 0.6);
    will-change: transform, opacity;
  }

  .tb-gem-sparkle {
    position: fixed;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 8px rgba(248, 184, 131, 0.9), 0 0 16px rgba(248, 184, 131, 0.5);
    pointer-events: none;
    z-index: 9993;
    will-change: transform, opacity;
  }

  html.tb-flash-gold {
    --tb-c-accent: #f8b883 !important;
  }

  canvas.tb-cursor-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9994;
    mix-blend-mode: screen;
  }

  @media (prefers-reduced-motion: reduce) {
    .tb-gem-badge-icon { animation: none; }
    canvas.tb-cursor-canvas { display: none; }
  }

  .tb-wisdom-gem {
    display: inline-block;
    width: 20px;
    height: 20px;
    color: var(--tb-c-accent);
    opacity: 0.35;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 0.3s var(--ease-out-quint, ease), transform 0.3s var(--ease-out-quint, ease);
    vertical-align: middle;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 4px rgba(248, 184, 131, 0.4));
    animation: tb-wisdom-twinkle 3s ease-in-out infinite;
  }
  .tb-wisdom-gem:hover,
  .tb-wisdom-gem:focus-visible {
    opacity: 1;
    transform: scale(1.6) rotate(180deg);
    outline: none;
    filter: drop-shadow(0 0 10px rgba(248, 184, 131, 0.8));
  }
  @keyframes tb-wisdom-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(1.1); }
  }
  .tb-wisdom-gem svg {
    width: 100%;
    height: 100%;
  }
  .tb-wisdom-gem.collected {
    opacity: 0 !important;
    pointer-events: none;
    transform: scale(0);
  }

  .tb-quote-card {
    position: fixed;
    top: 38%;
    left: 50%;
    z-index: 9996;
    max-width: min(28rem, 90vw);
    padding: 2rem 2.5rem;
    border-radius: 1.5rem;
    background: var(--tb-c-card, #fff);
    border: 1px solid var(--tb-c-accent, #c36242);
    box-shadow: 0 20px 60px -20px rgba(6, 57, 74, 0.3), 0 0 50px rgba(248, 184, 131, 0.15);
    text-align: center;
    pointer-events: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .tb-quote-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--tb-c-text-1, #1a2b34);
    font-weight: 500;
  }
  .tb-quote-author {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--tb-c-text-3, #7a8b94);
    letter-spacing: 0.02em;
  }

  .tb-wisdom-flyer {
    position: fixed;
    z-index: 9995;
    pointer-events: none;
    will-change: transform, opacity;
    filter: drop-shadow(0 0 8px rgba(248, 184, 131, 0.8));
  }
  .tb-wisdom-flyer svg {
    width: 28px;
    height: 28px;
    color: var(--color-gold);
  }

  .tb-lore-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(3, 29, 40, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 0.6s ease;
    padding: 1.5rem;
  }
  .tb-lore-overlay.visible {
    opacity: 1;
  }
  .tb-lore-card {
    position: relative;
    max-width: 34rem;
    max-height: 85vh;
    overflow-y: auto;
    padding: 3rem 2.5rem;
    border-radius: 1.5rem;
    background: linear-gradient(160deg, var(--color-ink), var(--color-ink-deep));
    border: 1px solid rgba(248, 184, 131, 0.2);
    box-shadow: 0 0 80px rgba(248, 184, 131, 0.1), 0 20px 60px rgba(0, 0, 0, 0.5);
    text-align: center;
    transform: translateY(20px) scale(0.95);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
  }
  .tb-lore-overlay.visible .tb-lore-card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  .tb-lore-kanji {
    font-size: 5rem;
    color: var(--color-gold);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .tb-lore-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }
  .tb-lore-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-paper);
    margin-bottom: 1.5rem;
  }
  .tb-lore-body {
    text-align: left;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-mist-pale);
  }
  .tb-lore-body p {
    margin-bottom: 1rem;
  }
  .tb-lore-body strong {
    color: var(--color-paper);
  }
  .tb-lore-body em {
    color: var(--color-gold);
    font-style: italic;
  }
  .tb-lore-divider {
    text-align: center;
    margin: 1.5rem 0;
    color: var(--color-gold);
    opacity: 0.4;
    letter-spacing: 0.5em;
  }
  .tb-lore-close {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    background: var(--tb-c-accent);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .tb-lore-close:hover {
    transform: translateY(-2px);
    background: var(--color-vermillion-deep);
  }
</style>

<script>
  import { initEasterEggs } from './easter'
  import { installCopyButtons } from '../../src/lib/copy-buttons'
  import { installHeadingAnchors } from '../../src/lib/heading-anchors'

  installCopyButtons()
  document.addEventListener('astro:after-swap', installCopyButtons)
  installHeadingAnchors()
  document.addEventListener('astro:after-swap', installHeadingAnchors)

  const start = () => initEasterEggs()
  if ('requestIdleCallback' in window) {
    requestIdleCallback(start, { timeout: 3000 })
  } else {
    setTimeout(start, 1000)
  }
</script>
