    "@astrojs/vue": "^7.0.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "pagefind": "^1.3.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.2",
